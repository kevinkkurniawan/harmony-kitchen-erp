# Harmony Kitchen Sync settings. Lines starting with # are notes.

# Legacy SQL Server at the store (read-only login, db_datareader)
MSSQL_SERVER=ERP-PC
MSSQL_PORT=1433
MSSQL_DATABASE=db_Harmony
MSSQL_USER=hk_sync_reader
MSSQL_PASSWORD=
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# Supabase Postgres used by the Vercel ERP and POS (session pooler or direct connection, not the transaction pooler)
DATABASE_URL=postgresql://hk_sync:PASSWORD@HOST:5432/postgres
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=false

# Rows created in the new app get ids from here up; the sync never touches them
TRIAL_ID_START=900000000
SYNC_INTERVAL_MINUTES=5
# How often every row of the large tables is compared (between those, only rows created in the last RECENT_DAYS)
FULL_EVERY_MINUTES=60
RECENT_DAYS=7
